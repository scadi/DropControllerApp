<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Widget.DropController.Card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_drop_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="@style/TextAppearance.DropController.CardTitle" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:labelFor="@+id/sp_solenoid"
                android:text="@string/drop_sol"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <Spinner
                android:id="@+id/sp_solenoid"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:background="@drawable/bg_dropdown"
                android:minWidth="72dp"
                android:paddingHorizontal="8dp" />
        </LinearLayout>

        <include
            android:id="@+id/row_start"
            layout="@layout/view_value_delta" />

        <include
            android:id="@+id/row_size"
            layout="@layout/view_value_delta" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
