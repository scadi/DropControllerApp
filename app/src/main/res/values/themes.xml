<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme: blue Material 3 scheme. The colors come from values/colors.xml and
         values-night/colors.xml, so one theme serves both the light and the dark mode. -->
    <style name="Base.Theme.DropControllerApp" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/md_primary</item>
        <item name="colorOnPrimary">@color/md_on_primary</item>
        <item name="colorPrimaryContainer">@color/md_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/md_on_primary_container</item>
        <item name="colorSecondary">@color/md_secondary</item>
        <item name="colorOnSecondary">@color/md_on_secondary</item>
        <item name="colorSecondaryContainer">@color/md_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/md_on_secondary_container</item>
        <item name="colorTertiary">@color/md_tertiary</item>
        <item name="colorOnTertiary">@color/md_on_tertiary</item>
        <item name="colorTertiaryContainer">@color/md_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/md_on_tertiary_container</item>
        <item name="colorError">@color/md_error</item>
        <item name="colorOnError">@color/md_on_error</item>
        <item name="colorErrorContainer">@color/md_error_container</item>
        <item name="colorOnErrorContainer">@color/md_on_error_container</item>
        <item name="android:colorBackground">@color/md_background</item>
        <item name="colorOnBackground">@color/md_on_background</item>
        <item name="colorSurface">@color/md_surface</item>
        <item name="colorOnSurface">@color/md_on_surface</item>
        <item name="colorSurfaceVariant">@color/md_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/md_on_surface_variant</item>
        <item name="colorOutline">@color/md_outline</item>
        <item name="colorOutlineVariant">@color/md_outline_variant</item>

        <!-- Tinted window background; cards (surface) stand out on it -->
        <item name="android:windowBackground">@color/md_background</item>
        <item name="android:windowLightStatusBar">@bool/light_system_bars</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">@bool/light_system_bars</item>

        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.DropController.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.DropController.Medium</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.DropController.Large</item>
    </style>

    <style name="Theme.DropControllerApp" parent="Base.Theme.DropControllerApp" />

    <!-- Shapes: rounded corners -->
    <style name="ShapeAppearance.DropController.Small" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <style name="ShapeAppearance.DropController.Medium" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <style name="ShapeAppearance.DropController.Large" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>

    <!-- Cards: outlined surface on the tinted background -->
    <style name="Widget.DropController.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">12dp</item>
        <item name="cardBackgroundColor">?attr/colorSurface</item>
        <item name="strokeColor">?attr/colorOutlineVariant</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardElevation">0dp</item>
    </style>

    <!-- Title of a screen or of a group inside a card -->
    <style name="TextAppearance.DropController.ScreenTitle" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="TextAppearance.DropController.CardTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>

    <!-- Drop cards are colored, so their content gets its own colors: light text on dark cards ... -->
    <style name="ThemeOverlay.DropController.CardLightText" parent="ThemeOverlay.Material3">
        <item name="colorPrimary">@color/drop_card_light_text</item>
        <item name="colorOnSurface">@color/drop_card_light_text</item>
        <item name="colorOnSurfaceVariant">@color/drop_card_light_text_variant</item>
        <item name="colorOutline">@color/drop_card_light_outline</item>
        <item name="colorOutlineVariant">@color/drop_card_light_outline</item>
        <item name="colorSecondaryContainer">@color/drop_card_light_container</item>
        <item name="colorOnSecondaryContainer">@color/drop_card_light_text</item>
    </style>

    <!-- ... and dark text on light cards -->
    <style name="ThemeOverlay.DropController.CardDarkText" parent="ThemeOverlay.Material3">
        <item name="colorPrimary">@color/drop_card_dark_primary</item>
        <item name="colorOnSurface">@color/drop_card_dark_text</item>
        <item name="colorOnSurfaceVariant">@color/drop_card_dark_text_variant</item>
        <item name="colorOutline">@color/drop_card_dark_outline</item>
        <item name="colorOutlineVariant">@color/drop_card_dark_outline</item>
        <item name="colorSecondaryContainer">@color/drop_card_dark_container</item>
        <item name="colorOnSecondaryContainer">@color/drop_card_dark_on_container</item>
    </style>
</resources>
